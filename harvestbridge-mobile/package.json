{
  "name": "harvestbridge-mobile",
  "main": "expo/AppEntry",
  "version": "1.0.0",
  "dependencies": {
    "@expo/ui": "0.2.0-beta.9",
    "@expo/vector-icons": "^15.0.3",
    "@hookform/resolvers": "^5.2.1",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.18.10",
    "@react-navigation/native": "^7.3.8",
    "@react-navigation/native-stack": "^7.18.2",
    "@tanstack/react-query": "^5.101.2",
    "axios": "^1.18.1",
    "expo": "~54.0.36",
    "expo-constants": "~18.0.13",
    "expo-device": "~8.0.10",
    "expo-file-system": "~19.0.23",
    "expo-font": "~14.0.12",
    "expo-glass-effect": "~0.1.10",
    "expo-image": "~3.0.11",
    "expo-image-picker": "~17.0.11",
    "expo-linking": "~8.0.12",
    "expo-localization": "~17.0.9",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.17",
    "expo-secure-store": "~15.0.8",
    "expo-sharing": "~14.0.8",
    "expo-splash-screen": "~31.0.13",
    "expo-status-bar": "~3.0.9",
    "expo-symbols": "~1.0.8",
    "expo-system-ui": "~6.0.9",
    "expo-video": "~3.0.16",
    "expo-web-browser": "~15.0.11",
    "nativewind": "^4.2.6",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-hook-form": "^7.66.0",
    "react-native": "0.81.5",
    "react-native-chart-kit": "^6.12.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-paper": "^5.14.5",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.5.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/react": "~19.1.10",
    "eslint": "^9.34.0",
    "eslint-config-expo": "~10.0.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.6.2",
    "typescript": "~5.9.2"
  },
  "scripts": {
    "start": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --lan",
    "start:tunnel": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --tunnel",
    "start:localhost": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --localhost",
    "reset-project": "node ./scripts/reset-project.js",
    "android": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --android --lan",
    "android:usb": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --localhost",
    "android:usb:open": "..\\.android-sdk\\platform-tools\\adb.exe shell am start -a android.intent.action.VIEW -d exp://127.0.0.1:8081",
    "android:tunnel": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --android --tunnel",
    "adb:devices": "..\\.android-sdk\\platform-tools\\adb.exe devices -l",
    "adb:reset": "..\\.android-sdk\\platform-tools\\adb.exe kill-server && ..\\.android-sdk\\platform-tools\\adb.exe start-server && ..\\.android-sdk\\platform-tools\\adb.exe devices -l",
    "ios": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --ios",
    "web": "set EXPO_ROUTER_DISABLE_RN_NAVIGATION_CHECK=1 && node ./scripts/expo.js start --web",
    "lint": "eslint . --ext .ts,.tsx,.js",
    "lint:fix": "eslint . --ext .ts,.tsx,.js --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "private": true
}
